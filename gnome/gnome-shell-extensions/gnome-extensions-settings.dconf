[EasyScreenCast]
file-container=2
file-folder='/home/kolaj/Videos/Screencasts'
file-resolution-height=1080
file-resolution-type=8
file-resolution-width=1920
input-audio-source=3
pipeline='queue max-size-buffers=0 max-size-time=0 max-size-bytes=0 ! videorate ! vp8enc min_quantizer=0 max_quantizer=5 cpu-used=3 deadline=1000000 threads=%T ! queue max-size-buffers=0 max-size-time=0 max-size-bytes=0 ! mux. pulsesrc ! queue max-size-buffers=0 max-size-time=0 max-size-bytes=0 ! audioconvert ! vorbisenc ! queue max-size-buffers=0 max-size-time=0 max-size-bytes=0 ! mux. webmmux name=mux '
quality-webcam=''

[advanced-alt-tab-window-switcher]
app-switcher-popup-search-pref-running=false
app-switcher-popup-titles=false
app-switcher-popup-win-counter=false
switcher-popup-del-key-close=true
switcher-popup-preview-selected=2
switcher-popup-show-if-no-win=false
switcher-popup-start-search=false
switcher-popup-status=false
switcher-popup-timeout=30
switcher-popup-tooltip-title=2
switcher-ws-thumbnails=2
win-switch-minimized-to-end=true
win-switcher-popup-filter=2
win-switcher-popup-preview-size=151
win-switcher-popup-search-all=false
win-switcher-popup-search-apps=false
win-switcher-popup-titles=1
win-switcher-single-prev-size=192
ws-switch-popup=true

