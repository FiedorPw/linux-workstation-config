clipboard-paste-protection = false
class = com.fiedor.Ghostty
gtk-single-instance = true

# wywalenie top baru
window-decoration = none
# nie potwierdzaj zamknięcia
confirm-close-surface = false

# --- colors (HackerGreen) ---
foreground = #00FF00
background = #000000
cursor-color = #A0A0A0
cursor-text = #000000
selection-background = #303030
selection-foreground = #00FF00

# ANSI 0–15
palette = 0=#808080
palette = 1=#D41919
palette = 2=#5EBDAB
palette = 3=#FEA44C
palette = 4=#367BF0
palette = 5=#9755B3
palette = 6=#49AEE6
palette = 7=#E6E6E6
palette = 8=#198388
palette = 9=#EC0101
palette = 10=#47D4B9
palette = 11=#FF8A18
palette = 12=#277FFF
palette = 13=#962AC3
palette = 14=#05A1F7
palette = 15=#FFFFFF

# --- font ---
font-family = "JetBrainsMono Nerd Font"
font-family = "Menlo"        # fallback
font-size   = 13

# --- window look ---
background-opacity = 1
unfocused-split-opacity = 1
unfocused-split-fill = #000000

# --- behavior ---
# WezTerm uses lines; Ghostty uses bytes. ~8MB ≈ plenty for ~5k lines.
scrollback-limit = 8000000

# --- shell ---
command = "/bin/zsh -l"

#macos-option-as-alt = left
# keybind = clear
# --- keybinds (Linux: physical Command → Alt via keyd) ---
keybind = alt+c=copy_to_clipboard
keybind = alt+v=paste_from_clipboard
keybind = alt+t=new_tab
keybind = alt+w=close_tab
keybind = ctrl+shift+w=close_surface
keybind = alt+ctrl+f=toggle_fullscreen

# Pane splitting
keybind = alt+d=new_split:right
keybind = alt+shift+d=new_split:down
keybind = ctrl+d=new_split:right
keybind = ctrl+shift+d=new_split:down

# Navigate splits
keybind = ctrl+shift+left=goto_split:left
keybind = ctrl+shift+right=goto_split:right
keybind = ctrl+shift+up=goto_split:up
keybind = ctrl+shift+down=goto_split:down
