clipboard-paste-protection = false
class = com.fiedor.Ghostty
gtk-single-instance = true

# wywalenie top baru
window-decoration = none
# nie potwierdzaj zamknięcia
confirm-close-surface = false

# --- colors (HackerGreen) ---
foreground = #00FF00
background = #000000
cursor-color = #A0A0A0
cursor-text = #000000
selection-background = #303030
selection-foreground = #00FF00

# ANSI 0–15
palette = 0=#808080
palette = 1=#D41919
palette = 2=#5EBDAB
palette = 3=#FEA44C
palette = 4=#367BF0
palette = 5=#9755B3
palette = 6=#49AEE6
palette = 7=#E6E6E6
palette = 8=#198388
palette = 9=#EC0101
palette = 10=#47D4B9
palette = 11=#FF8A18
palette = 12=#277FFF
palette = 13=#962AC3
palette = 14=#05A1F7
palette = 15=#FFFFFF

# --- font ---
font-family = "JetBrainsMono Nerd Font"
font-family = "Menlo"        # fallback
font-size   = 13

# --- window look ---
background-opacity = 0.92
background-blur    = 18
macos-titlebar-style = hidden
# window-decoration = auto    # default; leave as-is

# --- behavior ---
# WezTerm uses lines; Ghostty uses bytes. ~8MB ≈ plenty for ~5k lines.
scrollback-limit = 8000000

# --- shell ---
command = "/bin/zsh -l"

#macos-option-as-alt = left
# keybind = clear
keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard

#keybind = alt+left=unbind
#keybind = alt+right=unbind

# make Option behave like Alt/Meta on macOS
# macos-option-as-alt = true

# send the standard readline “word” escapes
macos-option-as-alt = left

# Nuke any leftovers for these combos, then set exactly what we want

# Send raw bytes for readline word jumps (ESC b / ESC f)
# keybind = alt+left=text:\x1bb
# keybind = alt+right=text:\x1bf
# --- keybinds (WezTerm equivalents) ---
keybind = cmd+t=new_tab
keybind = cmd+w=close_tab
keybind = ctrl+shift+w=close_surface
keybind = cmd+ctrl+f=toggle_fullscreen

# Pane splitting and closing (Ctrl+D split, Ctrl+W close)
keybind = ctrl+d=new_split:right
keybind = ctrl+shift+d=new_split:down
keybind = ctrl+w=close_surface

keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
# keybind = alt+left=esc:b
# keybind = alt+right=esc:f
# jumping stuff
keybind = ctrl+shift+left=goto_split:left
keybind = ctrl+shift+right=goto_split:right
keybind = ctrl+shift+up=goto_split:up
keybind = ctrl+shift+down=goto_split:down


