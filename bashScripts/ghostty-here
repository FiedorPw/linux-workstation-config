#!/usr/bin/env bash
# Open ghostty at current Nautilus location (F4 like in Kali)

# Get the current Nautilus URI
NAUTILUS_URI=$(gdbus call --session \
    --dest org.gnome.Nautilus \
    --object-path /org/gnome/Nautilus/window/1 \
    --method org.gtk.Actions.Describe "location" 2>/dev/null | \
    grep -oP "(?<=')[^']+(?=')" | head -1)

# Fallback: try to get active window and parse path
if [[ -z "$NAUTILUS_URI" ]]; then
    # Try to get path from window title or default to home
    CURRENT_PATH=$(xdotool getactivewindow getwindowname 2>/dev/null | grep -oP '(?<=— ).*' || echo "$HOME")
    
    # If path doesn't exist, use home
    if [[ ! -d "$CURRENT_PATH" ]]; then
        CURRENT_PATH="$HOME"
    fi
else
    # Convert file:// URI to path
    CURRENT_PATH=$(echo "$NAUTILUS_URI" | sed 's|^file://||' | urldecode 2>/dev/null || echo "$HOME")
fi

# Launch ghostty at the current location
cd "$CURRENT_PATH" 2>/dev/null || cd "$HOME"
ghostty &
