#!/usr/bin/env bash
# Toggle Ghostty: focus if running, launch if not

GHOSTTY_PID=$(pgrep -x ghostty)

if [[ -n "$GHOSTTY_PID" ]]; then
    # Ghostty is running, focus it
    if command -v xdotool >/dev/null 2>&1; then
        xdotool search --class "ghostty" windowactivate
    elif command -v wmctrl >/dev/null 2>&1; then
        wmctrl -xa ghostty
    else
        # Fallback: just bring to front
        ghostty &
    fi
else
    # Ghostty not running, launch it
    ghostty &
fi
