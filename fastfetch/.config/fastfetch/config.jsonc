{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "fedora-asahi-remix",
    "color": {
      "1": "green",
      "2": "green"
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "type": "both"
    },
    "color": {
      "keys": "green",
      "title": "green",
      "separator": "white"
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "green",
        "host": "white"
      }
    },
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ]
}
