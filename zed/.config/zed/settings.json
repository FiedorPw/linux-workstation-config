// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "git_panel": {
    "dock": "left"
  },
  "global_lsp_settings": {
    "semantic_token_rules": [
      {
        "token_type": "function.defaultLibrary:python",
        "token_modifiers": [],
        "style": [],
        "foreground_color": "#ffffffff",
        "background_color": null,
        "underline": null,
        "strikethrough": null,
        "font_weight": null,
        "font_style": "italic"
      },
      {
        "token_type": "variable.readonly:python",
        "token_modifiers": [],
        "style": [],
        "foreground_color": "#bbb529ff",
        "background_color": null,
        "underline": null,
        "strikethrough": null,
        "font_weight": "bold",
        "font_style": null
      },
      {
        "token_type": "keyword:python",
        "token_modifiers": [],
        "style": [],
        "foreground_color": "#cc7832ff",
        "background_color": null,
        "underline": null,
        "strikethrough": null,
        "font_weight": "bold",
        "font_style": null
      },
      {
        "token_type": "comment:python",
        "token_modifiers": [],
        "style": [],
        "foreground_color": "#737373ff",
        "background_color": null,
        "underline": null,
        "strikethrough": null,
        "font_weight": null,
        "font_style": "italic"
      },
      {
        "token_type": "*.static:python",
        "token_modifiers": [],
        "style": [],
        "foreground_color": "#d0bfffc3",
        "background_color": null,
        "underline": null,
        "strikethrough": null,
        "font_weight": "bold",
        "font_style": null
      },
      {
        "token_type": "*.abstract:python",
        "token_modifiers": [],
        "style": [],
        "foreground_color": "#b39ddbff",
        "background_color": null,
        "underline": null,
        "strikethrough": null,
        "font_weight": null,
        "font_style": "italic"
      },
      {
        "token_type": "*.async:python",
        "token_modifiers": [],
        "style": [],
        "foreground_color": "#37b690ff",
        "background_color": null,
        "underline": true,
        "strikethrough": null,
        "font_weight": null,
        "font_style": null
      },
      {
        "token_type": "*.deprecated:python",
        "token_modifiers": [],
        "style": [],
        "foreground_color": "#737373ff",
        "background_color": null,
        "underline": null,
        "strikethrough": true,
        "font_weight": null,
        "font_style": null
      },
      {
        "token_type": "*.defaultLibrary:python",
        "token_modifiers": [],
        "style": [],
        "foreground_color": "#a9b7c6ff",
        "background_color": null,
        "underline": null,
        "strikethrough": null,
        "font_weight": null,
        "font_style": "italic"
      }
    ]
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "colorize_brackets": true,
  "semantic_tokens": "full",
  "icon_theme": {
    "mode": "dark",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme"
  },
  "session": {
    "trust_all_worktrees": true
  },
  "vim_mode": true,
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Solarized Dark",
  },
}
